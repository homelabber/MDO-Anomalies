// MDO-S6 | Suspicious inbox rule followed by finance/payment mail sent externally (BEC thread hijack)
// A rule that forwards mail, uses finance keywords, has an obfuscated name, or moves mail to RSS /
// Conversation History is followed within 72 hours by outbound mail from the same mailbox with
// payment, invoice or banking language in the subject.
// Frequency: every 1 hour (4 hour lookback).
let lookback = 4h;
let chainWindow = 72h;
let rules = CloudAppEvents
    | where Timestamp > ago(lookback + chainWindow)
    | where Application == "Microsoft Exchange Online"
    | where ActionType in ("New-InboxRule", "Set-InboxRule", "UpdateInboxRules", "Set-Mailbox")
    | extend Params = strcat(tostring(RawEventData.Parameters), tostring(RawEventData.OperationProperties))
    | extend RuleName = extract(@'"Name"\s*:\s*"Name"\s*,\s*"Value"\s*:\s*"([^"]*)"', 1, Params)
    | where Params has_any ("invoice", "payment", "wire", "bank", "banking", "remittance", "ACH", "payroll", "W-2", "transfer", "overdue", "statement")
        or Params has_any ("RSS", "Conversation History", "ForwardTo", "RedirectTo", "ForwardAsAttachmentTo", "ForwardingSmtpAddress", "ForwardingAddress")
        or (isnotempty(RuleName) and (strlen(trim(" ", RuleName)) <= 2 or RuleName matches regex "^[^A-Za-z0-9]+$"))
    | project RuleTime = Timestamp, SenderFromAddress = tolower(tostring(RawEventData.UserId)), AccountObjectId,
        RuleName, RuleActionType = ActionType, RuleIP = IPAddress, Params;
EmailEvents
| where Timestamp > ago(lookback)
| where EmailDirection == "Outbound"
| where Subject has_any ("invoice", "payment", "wire", "bank", "banking", "remittance", "ACH", "payroll", "W-2", "transfer", "overdue", "statement")
| extend SenderFromAddress = tolower(SenderFromAddress)
| join kind=inner rules on SenderFromAddress
| where Timestamp between (RuleTime .. (RuleTime + chainWindow))
| summarize arg_max(RuleTime, RuleName, RuleActionType, RuleIP, Params)
    by Timestamp, ReportId, NetworkMessageId, SenderFromAddress, RecipientEmailAddress, Subject, AccountObjectId
| project Timestamp, ReportId, NetworkMessageId, SenderFromAddress, RecipientEmailAddress, Subject, AccountObjectId,
    RuleTime, RuleName, RuleActionType, RuleIP, Params
